# ─────────────────────────────────────────────────────────────
# تنظیمات پنل مانیتورینگ پاسارگاد میزبان
# این فایل را به .env کپی کنید و مقادیر را پر کنید.
# .env هرگز نباید در گیت برود.
# ─────────────────────────────────────────────────────────────

# ── دیتابیس ──────────────────────────────────────────────────
POSTGRES_USER=pasargad
POSTGRES_PASSWORD=یک-گذرواژه-قوی-اینجا
POSTGRES_DB=pasargad_monitor

# ── امنیت نشست ───────────────────────────────────────────────
# حداقل ۳۲ کاراکتر تصادفی. تولید با:  openssl rand -base64 48
SESSION_SECRET=

# ── کاربر مدیر اولیه ─────────────────────────────────────────
# فقط بار اول و وقتی جدول کاربران خالی است استفاده می‌شود.
# بعد از اولین ورود، این دو خط را خالی کنید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PHONE=09121234567
ADMIN_NAME=مدیر سیستم

# ── پیامک کاوه‌نگار ──────────────────────────────────────────
# بدون این کلید، هیچ هشدار پیامکی ارسال نمی‌شود.
KAVENEGAR_API_KEY=
# خط ارسال؛ خالی یعنی خط پیش‌فرض حساب
KAVENEGAR_SENDER=

# --- هشدار تلگرام ---
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# api.telegram.org از ایران در دسترس نیست. اگر سرور پنل داخل ایران است،
# اینجا را روی یک واسط انجین‌ایکس روی سرور خارج بگذارید، وگرنه هر ارسال
# با خطای اتصال شکست می‌خورد. خالی یعنی مستقیم.
TELEGRAM_API_BASE=

# ویژالیزور: نودها از پنل تعریف می‌شوند، نه اینجا — چون چند نود داریم و
# هرکدام کلید خودش را دارد. صفحه «ویژالیزور» در پنل.

# ── عمومی ────────────────────────────────────────────────────
# مبنای مرز روز در تجمیع و گزارش. اگر عوض شود، داده‌های قدیمی
# با مرز قبلی تجمیع شده‌اند و چند روز اول ناهماهنگ خواهد بود.
REPORT_TZ=Asia/Tehran

# فاصله ارسال ایجنت‌ها به ثانیه. پنل این عدد را در پاسخ به ایجنت
# برمی‌گرداند و ایجنت خودش را با آن هماهنگ می‌کند.
AGENT_INTERVAL_SEC=10

# سقف اتصال همزمان به پستگرس
PG_POOL_MAX=10
