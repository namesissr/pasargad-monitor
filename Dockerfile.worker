FROM node:20-alpine

# iputils برای پینگ واقعی لازم است؛ پینگ بیزی‌باکس خروجی متفاوتی دارد و
# زمان پاسخ را جور دیگری چاپ می‌کند.
RUN apk add --no-cache iputils tzdata

WORKDIR /app
ENV TZ=Asia/Tehran
ENV NODE_ENV=production

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY worker ./worker

# ورکر با روت اجرا می‌شود چون پینگ در برخی کرنل‌ها به سوکت خام نیاز دارد،
# و سرور TFTP سوییچ‌ها روی پورت ۶۹ گوش می‌دهد. آن پورت فقط وقتی کاری در
# جریان است باز است، و در docker-compose پیش‌فرض فقط به localhost وصل است.
CMD ["node", "worker/index.mjs"]
